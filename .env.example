TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Публичный URL (HTTPS), без финального /. При смене ngrok домена обновите и перезапустите процесс — иначе бот будет молчать. Закомментируйте/уберите для разработки с long polling: при старте webhook на стороне Telegram будет снят.
APP_URL=https://your-public-mini-app-url
# Railway: в Variables задайте APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}} (без слеша в конце домена не критично — сервер обрежет).
# Опционально: тот же секрет нужно передать в setWebhook и проверять в заголовке X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Слушать: на Railway по умолчанию 0.0.0.0 (если задан RAILWAY_ENVIRONMENT). Иначе ::. При проблемах с ngrok на Windows: HOST=127.0.0.1
HOST=
PORT=3000
REPORTING_CURRENCY=USD
EXCHANGE_RATE_SYNC_INTERVAL_MINUTES=360
