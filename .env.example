TELEGRAM_BOT_TOKEN=your_telegram_bot_token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Публичный URL (HTTPS), без финального /. При смене ngrok домена обновите и перезапустите процесс — иначе бот будет молчать. Закомментируйте/уберите для разработки с long polling: при старте webhook на стороне Telegram будет снят.
APP_URL=https://your-public-mini-app-url
# Опционально: тот же секрет нужно передать в setWebhook и проверять в заголовке X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Слушать на :: по умолчанию (dual-stack). На Windows при ERR_NGROK_8012 / [::1]:PORT попробуйте HOST=127.0.0.1 и команду ngrok: ngrok http 127.0.0.1:3000 (не просто localhost:3000).
HOST=
PORT=3000
REPORTING_CURRENCY=USD
EXCHANGE_RATE_SYNC_INTERVAL_MINUTES=360
